<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Akad Nikah — Daniel Qayyum &amp; Izza Nabila</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ivory:#F7F3EA;
    --ivory-deep:#EFE8D8;
    --forest:#3A4A3C;
    --forest-deep:#28352A;
    --dusty-pink:#D9B7B4;
    --gold:#A8894F;
    --ink:#33342E;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ivory);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:300;
    overflow-x:hidden;
  }
  h1,h2,h3, .display{
    font-family:'Cormorant Garamond', serif;
    font-weight:500;
    letter-spacing:0.02em;
  }
  .eyebrow{
    font-family:'Jost', sans-serif;
    font-size:0.72rem;
    letter-spacing:0.32em;
    text-transform:uppercase;
    color:var(--gold);
  }

  .leaf-scatter{
    position:fixed; inset:0;
    pointer-events:none;
    z-index:0;
    opacity:0.06;
  }

  section{
    position:relative;
    z-index:1;
    padding:5.5rem 1.5rem;
    max-width:720px;
    margin:0 auto;
  }

  .hero{
    min-height:100svh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:3rem 1.5rem;
    position:relative;
  }
  .hero-frame{
    position:relative;
    padding:3.5rem 2rem;
  }
  .hero-frame::before, .hero-frame::after{
    content:"";
    position:absolute;
    left:50%;
    transform:translateX(-50%);
    width:1px;
    height:56px;
    background:linear-gradient(var(--gold), transparent);
  }
  .hero-frame::before{ top:0; }
  .hero-frame::after{ bottom:0; transform:translateX(-50%) rotate(180deg); }

  .hero .eyebrow{ opacity:0; animation:fadeUp 1s ease forwards 0.2s; }
  .hero h1{
    font-size:clamp(2.6rem, 9vw, 4.4rem);
    color:var(--forest-deep);
    margin:1.1rem 0;
    opacity:0; animation:fadeUp 1.1s ease forwards 0.5s;
  }
  .hero h1 em{
    font-style:italic;
    color:var(--gold);
    display:block;
    font-size:0.42em;
    letter-spacing:0.12em;
    margin:0.4rem 0;
  }
  .hero .sub{
    font-size:0.95rem;
    letter-spacing:0.08em;
    color:var(--forest);
    opacity:0; animation:fadeUp 1.1s ease forwards 0.8s;
  }
  .hero .date-badge{
    margin-top:2.2rem;
    display:inline-flex;
    gap:0.9rem;
    align-items:center;
    padding:0.7rem 1.6rem;
    border:1px solid rgba(168,137,79,0.4);
    border-radius:999px;
    font-size:0.78rem;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--forest-deep);
    opacity:0; animation:fadeUp 1.1s ease forwards 1.1s;
  }
  .date-badge .dot{ width:4px; height:4px; border-radius:50%; background:var(--dusty-pink); }

  @keyframes fadeUp{
    from{ opacity:0; transform:translateY(18px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .scroll-cue{
    position:absolute;
    bottom:2.2rem; left:50%; transform:translateX(-50%);
    font-size:0.65rem;
    letter-spacing:0.3em;
    text-transform:uppercase;
    color:var(--forest);
    opacity:0.6;
    animation:bob 2.4s ease-in-out infinite;
  }
  @keyframes bob{
    0%,100%{ transform:translate(-50%,0); }
    50%{ transform:translate(-50%,8px); }
  }

  .divider{
    display:flex; align-items:center; gap:1rem;
    max-width:280px; margin:0 auto;
    color:var(--gold);
  }
  .divider .line{ flex:1; height:1px; background:rgba(168,137,79,0.35); }
  .divider svg{ width:18px; height:18px; opacity:0.8; }

  .film-section{ text-align:center; }
  .film-section h2{
    font-size:clamp(1.8rem,5vw,2.6rem);
    color:var(--forest-deep);
    margin:0.8rem 0 0.5rem;
  }
  .film-section p.note{
    font-size:0.88rem;
    color:var(--forest);
    max-width:420px;
    margin:0 auto 2.4rem;
    line-height:1.7;
  }
  .video-wrap{
    position:relative;
    border-radius:4px;
    overflow:hidden;
    box-shadow:0 30px 60px -20px rgba(40,53,42,0.35);
    border:1px solid rgba(168,137,79,0.25);
    background:var(--forest-deep);
    max-width:420px;
    margin:0 auto;
  }
  .video-wrap iframe{
    width:100%;
    aspect-ratio:9/16;
    display:block;
    border:0;
  }

  .details{ text-align:center; }
  .details h2{
    font-size:clamp(1.8rem,5vw,2.6rem);
    color:var(--forest-deep);
    margin:0.8rem 0 3rem;
  }
  .detail-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:2.2rem;
    text-align:left;
    max-width:460px;
    margin:0 auto;
  }
  .detail-item{
    display:flex;
    gap:1.2rem;
    align-items:flex-start;
    padding-bottom:1.8rem;
    border-bottom:1px solid rgba(58,74,60,0.12);
  }
  .detail-item:last-child{ border-bottom:none; }
  .detail-icon{
    flex:none;
    width:42px; height:42px;
    border-radius:50%;
    background:var(--ivory-deep);
    display:flex; align-items:center; justify-content:center;
    color:var(--forest);
  }
  .detail-icon svg{ width:18px; height:18px; }
  .detail-text .label{
    font-size:0.68rem;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:0.35rem;
  }
  .detail-text .value{
    font-family:'Cormorant Garamond', serif;
    font-size:1.35rem;
    color:var(--forest-deep);
    line-height:1.4;
  }
  .detail-text .sub-value{
    font-size:0.82rem;
    color:var(--ink);
    opacity:0.75;
    margin-top:0.3rem;
  }
  .map-link{
    display:inline-flex;
    align-items:center;
    gap:0.5rem;
    margin-top:0.6rem;
    font-size:0.78rem;
    letter-spacing:0.06em;
    color:var(--forest);
    text-decoration:none;
    border-bottom:1px solid var(--dusty-pink);
    padding-bottom:2px;
    transition:opacity 0.2s;
  }
  .map-link:hover{ opacity:0.65; }

  .rsvp{
    background:var(--forest-deep);
    color:var(--ivory);
    padding:5.5rem 1.5rem 6rem;
    text-align:center;
  }
  .rsvp .eyebrow{ color:var(--dusty-pink); }
  .rsvp h2{
    font-size:clamp(1.8rem,5vw,2.6rem);
    color:var(--ivory);
    margin:0.8rem 0 0.6rem;
  }
  .rsvp p.note{
    font-size:0.88rem;
    color:rgba(247,243,234,0.7);
    max-width:400px;
    margin:0 auto 2.4rem;
    line-height:1.7;
  }
  .form-wrap{
    background:var(--ivory);
    border-radius:6px;
    overflow:hidden;
    max-width:640px;
    margin:0 auto;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.45);
  }
  .form-wrap iframe{
    width:100%;
    height:900px;
    border:0;
    display:block;
  }
  .form-fallback{
    display:inline-block;
    margin-top:1.6rem;
    font-size:0.8rem;
    letter-spacing:0.06em;
    color:var(--dusty-pink);
    text-decoration:none;
    border-bottom:1px solid rgba(217,183,180,0.5);
    padding-bottom:2px;
  }

  footer{
    text-align:center;
    padding:3rem 1.5rem 3.5rem;
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size:1.1rem;
    color:var(--forest);
  }

  @media (prefers-reduced-motion: reduce){
    .hero .eyebrow, .hero h1, .hero .sub, .hero .date-badge{ animation:none !important; opacity:1 !important; }
    .scroll-cue{ animation:none; }
  }

  a:focus-visible, button:focus-visible{
    outline:2px solid var(--gold);
    outline-offset:3px;
  }
</style>
</head>
<body>

<!-- HERO -->
<section class="hero">
  <div class="hero-frame">
    <p class="eyebrow">Sabait Ijab, Sakalun Qabul</p>
    <h1>Daniel Qayyum<em>&amp;</em>Izza Nabila</h1>
    <p class="sub">#DanIzzainLove</p>
    <div class="date-badge">
      <span>Sabtu, 26 September 2026</span>
      <span class="dot"></span>
      <span>Tepian Rimba Villa</span>
